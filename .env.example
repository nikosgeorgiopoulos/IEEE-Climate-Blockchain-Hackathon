APP_ENV=dev
DB_PATH=data/proofofair.db
KEYS_DIR=data/keys
ATHENS_LAT=37.98
ATHENS_LON=23.73
ATHENS_RADIUS_KM=30
INGEST_INTERVAL_SEC=300
BATCH_INTERVAL_SEC=600          # use 120 while recording the demo
SIM_DEVICES=12                  # simulated sensors so the map is never empty
ANCHOR_BACKEND=mock             # mock | polygon | ots
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002
POLYGON_EXPLORER=https://amoy.polygonscan.com
POLYGON_PRIVATE_KEY=            # testnet-only key; NEVER a real wallet
ANCHOR_CONTRACT_ADDRESS=
DEMO_MODE=true                  # enables Tamper Lab endpoints
